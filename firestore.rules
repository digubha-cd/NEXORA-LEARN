rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Student Profiles
    // Student ID must be immutable once created
    match /students/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) && 
        // Enforce studentId immutability if already present in resource
        (!('studentId' in resource.data) || resource.data.studentId == '' || request.resource.data.studentId == resource.data.studentId);
      allow delete: if isOwner(userId);

      // Friends subcollection
      match /friends/{friendId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Student ID Index Collection for fast, unique lookups and collision prevention
    match /student_ids/{studentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && !exists(/databases/$(database)/documents/student_ids/$(studentId));
      allow update: if false; // Student IDs are permanent and immutable
      allow delete: if false;
    }

    // Friend Requests Collection
    match /friend_requests/{requestId} {
      allow read: if isAuthenticated() && 
        (resource.data.senderUid == request.auth.uid || resource.data.receiverUid == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.senderUid == request.auth.uid;
      allow update: if isAuthenticated() && 
        (resource.data.senderUid == request.auth.uid || resource.data.receiverUid == request.auth.uid);
      allow delete: if isAuthenticated() && 
        (resource.data.senderUid == request.auth.uid || resource.data.receiverUid == request.auth.uid);
    }

    // 1-to-1 Chat Messages
    match /chats/{chatId}/messages/{messageId} {
      allow read, write: if isAuthenticated();
    }
  }
}
